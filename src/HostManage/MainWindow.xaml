<Window x:Class="HostManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HostManage"
        xmlns:models="clr-namespace:HostManage.Models"
        xmlns:views="clr-namespace:HostManage.Views"
        mc:Ignorable="d"
        Title="Host 管理器"
        Height="720"
        Width="1280"
        MinHeight="600"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <materialDesign:PackIcon Kind="ServerNetwork"
                                         Width="32" Height="32"
                                         Foreground="{StaticResource TextInverseBrush}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="Host 管理器"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextInverseBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Border Background="{StaticResource PrimaryDarkBrush}"
                        CornerRadius="12" Padding="10,4"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Folder" Width="16" Height="16"
                                                 Foreground="{StaticResource TextInverseBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentEnvironment.Name, FallbackValue='默认环境', TargetNullValue='未选择环境'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextInverseBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                         Foreground="{StaticResource TextInverseBrush}"
                                         VerticalAlignment="Center" Margin="0,0,-28,0" Panel.ZIndex="1" />
                <TextBox x:Name="SearchTextBox"
                         Width="360" Height="36" FontSize="13"
                         materialDesign:HintAssist.Hint="搜索 IP / 域名 / 注释..."
                         materialDesign:HintAssist.Foreground="{StaticResource TextInverseBrush}"
                         Foreground="{StaticResource TextInverseBrush}"
                         BorderBrush="{StaticResource TextInverseBrush}"
                         Background="{x:Null}"
                         Opacity="0.9"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="32,0,12,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="刷新数据" Margin="8,0,0,0">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"
                                             Foreground="{StaticResource TextInverseBrush}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,16,0">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddRuleCommand}" ToolTip="添加规则"
                        Background="{StaticResource PrimaryDarkBrush}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="添加" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchEnableCommand}" ToolTip="批量启用"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="启用" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchDisableCommand}" ToolTip="批量禁用"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pause" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="禁用" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchDeleteCommand}" ToolTip="批量删除"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="删除" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator Width="8" Background="Transparent" />
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ImportCommand}" ToolTip="导入规则"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导入" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ExportCommand}" ToolTip="导出规则"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导出" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding CompareCommand}" ToolTip="与系统hosts对比"
                        Background="{x:Null}" Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Compare" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="对比" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator Width="8" Background="Transparent" />
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding OpenSettingsCommand}" ToolTip="设置">
                    <materialDesign:PackIcon Kind="Settings" Width="22" Height="22"
                                             Foreground="{StaticResource TextInverseBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavigationListBox"
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         Padding="8" FontSize="14"
                         SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="Rules" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="HOST 规则" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Environments">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="环境管理" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Proxy">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Server" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="代理配置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Backup">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="备份恢复" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Logs">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="操作日志" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="全局设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl x:Name="MainContentControl" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" ToolTip="规则总数">
                        <materialDesign:PackIcon Kind="FormatListNumbered" Width="14" Height="14"
                                                 VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding FilteredRules.Count, StringFormat='总数: {0}'}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <Separator Width="16" Background="Transparent" />
                    <StackPanel Orientation="Horizontal" ToolTip="启用规则数">
                        <materialDesign:PackIcon Kind="Check" Width="14" Height="14"
                                                 VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{Binding EnabledCount, StringFormat='启用: {0}'}"
                                   FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                             VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="HostsFilePathTextBlock"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="400" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border x:Name="AdminStatusBorder"
                            Background="{StaticResource WarningBrush}"
                            CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="12" Height="12"
                                                     VerticalAlignment="Center" Foreground="White" />
                            <TextBlock x:Name="AdminStatusText" Text="普通用户"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource InfoBrush}"
                            CornerRadius="8" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerOff" Width="12" Height="12"
                                                     VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="无代理" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CurrentTimeTextBlock"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
