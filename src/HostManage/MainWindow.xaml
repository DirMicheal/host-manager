<Window x:Class="HostManage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HostManage"
        xmlns:models="clr-namespace:HostManage.Models"
        xmlns:vm="clr-namespace:HostManage.ViewModels"
        mc:Ignorable="d"
        Title="Host 管理器"
        Height="720"
        Width="1280"
        MinHeight="600"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <vm:MainViewModel x:Key="DesignMainViewModel" d:IsDataSource="True" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <materialDesign:PackIcon Kind="ServerNetwork"
                                         Width="32"
                                         Height="32"
                                         Foreground="{StaticResource TextInverseBrush}"
                                         VerticalAlignment="Center" />
                <TextBlock Text="Host 管理器"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextInverseBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <Border Background="{StaticResource PrimaryDarkBrush}"
                        CornerRadius="12"
                        Padding="10,4"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Folder"
                                                 Width="16"
                                                 Height="16"
                                                 Foreground="{StaticResource TextInverseBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentEnvironment.Name, FallbackValue='默认环境', TargetNullValue='未选择环境'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextInverseBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Magnify"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource TextInverseBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,-28,0"
                                         Panel.ZIndex="1" />
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource SearchTextBox}"
                         Width="360"
                         materialDesign:HintAssist.Hint="搜索 IP / 域名 / 注释..."
                         materialDesign:HintAssist.Foreground="{StaticResource TextInverseBrush}"
                         Foreground="{StaticResource TextInverseBrush}"
                         BorderBrush="{StaticResource TextInverseBrush}"
                         Background="{x:Null}"
                         Opacity="0.9"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="32,0,12,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="刷新数据"
                        Margin="8,0,0,0">
                    <materialDesign:PackIcon Kind="Refresh"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource TextInverseBrush}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddRuleCommand}"
                        ToolTip="添加规则"
                        Background="{StaticResource PrimaryDarkBrush}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="添加" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchEnableCommand}"
                        ToolTip="批量启用"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="启用" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchDisableCommand}"
                        ToolTip="批量禁用"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pause" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="禁用" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BatchDeleteCommand}"
                        ToolTip="批量删除"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="删除" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Width="8" Background="Transparent" />

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ImportCommand}"
                        ToolTip="导入规则"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导入" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ExportCommand}"
                        ToolTip="导出规则"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="导出" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding CompareCommand}"
                        ToolTip="与系统hosts对比"
                        Background="{x:Null}"
                        Foreground="{StaticResource TextInverseBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Compare" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="对比" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Width="8" Background="Transparent" />

                <Button Style="{StaticResource IconButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="设置">
                    <materialDesign:PackIcon Kind="Settings"
                                             Width="22"
                                             Height="22"
                                             Foreground="{StaticResource TextInverseBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavigationListBox"
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         FontSize="14">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}" />
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Tag="Rules" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="HOST 规则" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Environments">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="环境管理" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Proxy">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Server"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="代理配置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Backup">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="备份恢复" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Logs">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextClockOutline"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="操作日志" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="全局设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl x:Name="MainContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="规则列表"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredRules.Count, StringFormat='共 {0} 条规则'}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />

                                <Separator Width="20" Background="Transparent" />

                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding BatchEnableCommand}"
                                        ToolTip="全部启用">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="全部启用" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding BatchDisableCommand}"
                                        ToolTip="全部禁用">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="全部禁用" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding BatchDeleteCommand}"
                                        ToolTip="批量删除选中">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" />
                                        <TextBlock Text="批量删除" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Separator Width="12" Background="Transparent" />

                                <Button Style="{StaticResource ToolbarButton}"
                                        ToolTip="冲突扫描">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text="冲突扫描" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ToolbarButton}"
                                        ToolTip="语法校验">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource InfoBrush}" />
                                        <TextBlock Text="语法校验" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="RulesDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding FilteredRules}"
                                  SelectionChanged="RulesDataGrid_SelectionChanged"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource SurfaceBrush}"
                                  AlternatingRowBackground="Transparent"
                                  RowHeaderWidth="0"
                                  LoadingRow="RulesDataGrid_LoadingRow"
                                  FontSize="13"
                                  Margin="0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="启用"
                                                        Width="60"
                                                        IsReadOnly="False"
                                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGridTextColumn Header="IP 地址"
                                                    Width="140"
                                                    IsReadOnly="True"
                                                    Binding="{Binding IP}"
                                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                                <DataGridTextColumn Header="域名"
                                                    Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding Domain}"
                                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                                <DataGridTextColumn Header="注释"
                                                    Width="240"
                                                    IsReadOnly="True"
                                                    Binding="{Binding Comment}"
                                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                                <DataGridTemplateColumn Header="状态" Width="100" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl>
                                                <ContentControl.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </ContentControl.Resources>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RuleStatus.Active}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource StatusActiveBadge}">
                                                                                <TextBlock Text="启用" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RuleStatus.Inactive}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource StatusInactiveBadge}">
                                                                                <TextBlock Text="禁用" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RuleStatus.Conflict}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource StatusConflictBadge}">
                                                                                <TextBlock Text="冲突" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RuleStatus.Invalid}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource StatusInvalidBadge}">
                                                                                <TextBlock Text="错误" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="操作" Width="140" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="编辑"
                                                        Margin="2,0">
                                                    <materialDesign:PackIcon Kind="PencilOutline"
                                                                             Width="18"
                                                                             Height="18"
                                                                             Foreground="{StaticResource PrimaryBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="启用/禁用"
                                                        Margin="2,0">
                                                    <materialDesign:PackIcon Kind="PowerSettingsNew"
                                                                             Width="18"
                                                                             Height="18"
                                                                             Foreground="{StaticResource WarningBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="删除"
                                                        Margin="2,0"
                                                        Click="DeleteRuleButton_Click"
                                                        Tag="{Binding}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                                             Width="18"
                                                                             Height="18"
                                                                             Foreground="{StaticResource ErrorBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ContentControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" ToolTip="规则总数">
                    <materialDesign:PackIcon Kind="FormatListNumbered"
                                             Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding FilteredRules.Count, StringFormat='总数: {0}'}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <Separator Width="16" Background="Transparent" />

                <StackPanel Orientation="Horizontal" ToolTip="启用规则数">
                    <materialDesign:PackIcon Kind="Check"
                                             Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="{Binding FilteredRules.Count, StringFormat='启用: {0}'}"
                               FontSize="12"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <Separator Width="16" Background="Transparent" />

                <StackPanel Orientation="Horizontal" ToolTip="冲突数">
                    <materialDesign:PackIcon Kind="Alert"
                                             Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="冲突: 0"
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <Separator Width="16" Background="Transparent" />

                <StackPanel Orientation="Horizontal" ToolTip="语法错误数">
                    <materialDesign:PackIcon Kind="CloseCircle"
                                             Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource ErrorBrush}" />
                    <TextBlock Text="错误: 0"
                               FontSize="12"
                               Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="HostsFilePathTextBlock"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border x:Name="AdminStatusBorder"
                        Background="{StaticResource SuccessBrush}"
                        CornerRadius="8"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck"
                                                 Width="12"
                                                 Height="12"
                                                 VerticalAlignment="Center"
                                                 Foreground="White" />
                        <TextBlock x:Name="AdminStatusText"
                                   Text="管理员"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource InfoBrush}"
                        CornerRadius="8"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ServerOff"
                                                 Width="12"
                                                 Height="12"
                                                 VerticalAlignment="Center"
                                                 Foreground="White" />
                        <TextBlock Text="无代理"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CurrentTimeTextBlock"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
