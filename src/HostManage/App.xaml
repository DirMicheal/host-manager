<Application x:Class="HostManage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HostManage"
             xmlns:converters="clr-namespace:HostManage.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Pink" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ThemeResources/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:RuleStatusToColorConverter x:Key="RuleStatusToColorConverter" />
            <converters:RuleStatusToStringConverter x:Key="RuleStatusToStringConverter" />
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter" />
            <converters:LogLevelToStringConverter x:Key="LogLevelToStringConverter" />
            <converters:DiffTypeToColorConverter x:Key="DiffTypeToColorConverter" />
            <converters:DiffTypeToStringConverter x:Key="DiffTypeToStringConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

            <Style x:Key="RuleRowActive" TargetType="DataGridRow">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            </Style>

            <Style x:Key="RuleRowInactive" TargetType="DataGridRow" BasedOn="{StaticResource RuleRowActive}">
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <Style x:Key="RuleRowConflict" TargetType="DataGridRow" BasedOn="{StaticResource RuleRowActive}">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#FFF3E0" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RuleRowInvalid" TargetType="DataGridRow" BasedOn="{StaticResource RuleRowActive}">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#FFEBEE" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusActiveBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusInactiveBadge" TargetType="Border" BasedOn="{StaticResource StatusActiveBadge}">
                <Setter Property="Background" Value="{StaticResource TextDisabledBrush}" />
            </Style>

            <Style x:Key="StatusConflictBadge" TargetType="Border" BasedOn="{StaticResource StatusActiveBadge}">
                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
            </Style>

            <Style x:Key="StatusInvalidBadge" TargetType="Border" BasedOn="{StaticResource StatusActiveBadge}">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            </Style>

            <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="4,2"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="6"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#BBDEFB" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
