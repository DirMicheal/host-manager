<Page x:Class="HostManage.Views.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="BackupPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="立即备份" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding CreateCommand}" Margin="0,0,8,0" Background="#FF4CAF50">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="立即备份" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="恢复选中" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding RestoreCommand}" Margin="0,0,8,0" Background="#FF2196F3">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="恢复选中" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="删除选中" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding DeleteCommand}" Margin="0,0,8,0" Background="#FFF44336">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="删除选中" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="导出备份" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ExportCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="导出备份" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="导入备份" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ImportCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="导入备份" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="清理旧备份" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding CleanCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="清理旧备份" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Snapshots}"
                  SelectedItem="{Binding SelectedSnapshot}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  materialDesign:DataGridAssist.CellPadding="8,4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="180"/>
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120"/>
                <DataGridTemplateColumn Header="类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:Chip>
                                <materialDesign:Chip.Style>
                                    <Style TargetType="materialDesign:Chip">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                <Setter Property="Content" Value="手动"/>
                                                <Setter Property="Background" Value="#FF2196F3"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsManual}" Value="False">
                                                <Setter Property="Content" Value="自动"/>
                                                <Setter Property="Background" Value="#FF9C27B0"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Chip.Style>
                            </materialDesign:Chip>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="恢复" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Margin="2,0" Padding="6,2" Background="#FF2196F3" Foreground="White">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="恢复" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="导出" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Margin="2,0" Padding="6,2">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Export" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="导出" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="删除" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Margin="2,0" Padding="6,2" Foreground="#FFF44336">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="删除" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
