<Page x:Class="HostManage.Views.HostRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:HostManage.Models"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="HostRulesPage">
    <Page.Resources>
        <Style x:Key="StatusActive" TargetType="materialDesign:Chip">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="StatusInactive" TargetType="materialDesign:Chip">
            <Setter Property="Background" Value="#FF9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="StatusConflict" TargetType="materialDesign:Chip">
            <Setter Property="Background" Value="#FFFF9800"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="StatusInvalid" TargetType="materialDesign:Chip">
            <Setter Property="Background" Value="#FFF44336"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="冲突扫描" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ScanConflictCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alert" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="冲突扫描" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="语法校验" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ValidateCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="语法校验" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="全部启用" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding EnableAllCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="全部启用" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="全部禁用" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding DisableAllCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="全部禁用" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </materialDesign:ColorZone>

        <DataGrid Grid.Row="1" x:Name="RulesDataGrid"
                  ItemsSource="{Binding FilteredRules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  MouseDoubleClick="RulesDataGrid_MouseDoubleClick"
                  materialDesign:DataGridAssist.CellPadding="8,4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,6">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="140"/>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="250"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:Chip Content="{Binding Status}" Width="90">
                                <materialDesign:Chip.Style>
                                    <Style TargetType="materialDesign:Chip">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                <Setter Property="Background" Value="#FF4CAF50"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                <Setter Property="Background" Value="#FF9E9E9E"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                                <Setter Property="Background" Value="#FFFF9800"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                                <Setter Property="Background" Value="#FFF44336"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Chip.Style>
                            </materialDesign:Chip>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ping状态" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PingIndicator" Width="10" Height="10" Fill="#FF9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PingStatusText}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Margin="2,0" Padding="6,2">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="编辑" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="删除" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Margin="2,0" Padding="6,2"
                                        Foreground="#FFF44336">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="删除" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="测试IP" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.TestIpCommand, ElementName=RulesDataGrid}"
                                        CommandParameter="{Binding}" Margin="2,0" Padding="6,2">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Radar" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBlock Text="测试" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <materialDesign:ColorZone Grid.Row="2" Mode="Standard" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <Run Text="共 "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" 条规则，启用 "/>
                    <Run Text="{Binding EnabledCount}" Foreground="#FF4CAF50"/>
                    <Run Text=" 条，禁用 "/>
                    <Run Text="{Binding DisabledCount}" Foreground="#FF9E9E9E"/>
                    <Run Text=" 条，冲突 "/>
                    <Run Text="{Binding ConflictCount}" Foreground="#FFFF9800"/>
                    <Run Text=" 条"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <Button Content="上一页" Style="{StaticResource MaterialDesignIconForegroundButton}" Command="{Binding PreviousPageCommand}"/>
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="8,0" MinWidth="30" TextAlignment="Center"/>
                    <TextBlock Text="/" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0" MinWidth="30"/>
                    <Button Content="下一页" Style="{StaticResource MaterialDesignIconForegroundButton}" Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <ComboBox Grid.Column="2" Width="100" SelectedIndex="{Binding PageSizeIndex, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center">
                    <ComboBoxItem Content="20条/页"/>
                    <ComboBoxItem Content="50条/页"/>
                    <ComboBoxItem Content="100条/页"/>
                </ComboBox>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Page>
