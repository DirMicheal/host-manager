<Page x:Class="HostManage.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="SettingsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Expander x:Name="BackupExpander" Header="备份设置" IsExpanded="True" Margin="0,0,0,8">
                <materialDesign:Card Padding="16" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自动备份" VerticalAlignment="Center" FontSize="14"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding AutoBackup}" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="最大备份数" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding MaxBackupCount}" VerticalAlignment="Center" Margin="0,0,16,8" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="份" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            </StackPanel>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Minimum="1" Maximum="100" Value="{Binding MaxBackupCount}"
                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Expander>

            <Expander x:Name="LogsExpander" Header="日志设置" IsExpanded="True" Margin="0,0,0,8">
                <materialDesign:Card Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="日志保留天数" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding LogRetentionDays}" VerticalAlignment="Center" Margin="0,0,16,8" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="天" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        </StackPanel>
                        <Slider Grid.Row="1" Grid.Column="1"
                                Minimum="7" Maximum="365" Value="{Binding LogRetentionDays}"
                                IsSnapToTickEnabled="True" TickFrequency="7"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </materialDesign:Card>
            </Expander>

            <Expander x:Name="ThemeExpander" Header="界面设置" IsExpanded="True" Margin="0,0,0,8">
                <materialDesign:Card Padding="16" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主题" VerticalAlignment="Center" FontSize="14"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton GroupName="Theme" Content="浅色模式"
                                             IsChecked="{Binding IsLightTheme}" Margin="0,0,24,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <BulletDecorator Background="Transparent">
                                                <BulletDecorator.Bullet>
                                                    <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="20" Height="20" Margin="0,0,6,0"
                                                                             Foreground="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToPrimaryColorConverter}}"/>
                                                </BulletDecorator.Bullet>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </BulletDecorator>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton GroupName="Theme" Content="深色模式"
                                             IsChecked="{Binding IsDarkTheme}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <BulletDecorator Background="Transparent">
                                                <BulletDecorator.Bullet>
                                                    <materialDesign:PackIcon Kind="WeatherNight" Width="20" Height="20" Margin="0,0,6,0"
                                                                             Foreground="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToPrimaryColorConverter}}"/>
                                                </BulletDecorator.Bullet>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </BulletDecorator>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="语言" VerticalAlignment="Center" FontSize="14"/>
                            <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Expander>

            <Expander x:Name="StartupExpander" Header="启动行为" IsExpanded="True" Margin="0,0,0,8">
                <materialDesign:Card Padding="16" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="开机自启动" VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="系统启动时自动运行本程序" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding AutoStart}" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="启动时应用上次环境" VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="程序启动后自动切换到上次使用的环境" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding AutoApplyEnvOnStartup}" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Expander>

            <Expander x:Name="UpdateExpander" Header="更新" IsExpanded="True" Margin="0,0,0,8">
                <materialDesign:Card Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="程序更新" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="当前版本: v1.0.0" FontSize="12" Foreground="#FF757575" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查更新" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding CheckUpdateCommand}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="检查更新" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </Grid>
                </materialDesign:Card>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="重置为默认" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ResetCommand}" Margin="0,0,8,0" Width="120"/>
                <Button Content="保存设置" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}" Background="#FF4CAF50" Width="120"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
