<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1E88E5"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#90CAF9"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#F48FB1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4DD0E1"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2D2D2D"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#757575"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="#212121"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#424242"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#333333"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E57373"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#64B5F6"/>

    <Color x:Key="PrimaryColor">#64B5F6</Color>
    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B0B0B0</Color>

</ResourceDictionary>
