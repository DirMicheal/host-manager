<Window x:Class="HostManage.Dialogs.TutorialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="680"
        Title="使用教程"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="680" Height="550">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="SchoolOutline" Width="32" Height="32"
                                     Foreground="White" Margin="24,16,16,16" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="0,16,24,16" VerticalAlignment="Center">
                <TextBlock Text="使用教程" FontWeight="Bold" FontSize="22" Foreground="White"/>
                <TextBlock Text="快速了解Host管理器的核心功能" FontSize="13" Foreground="#FFE0E0E0" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="8" Margin="24,20,24,10">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator1" Kind="Numeric1Circle" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="欢迎" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator2" Kind="Numeric2CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="基础操作" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator3" Kind="Numeric3CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="多环境" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator4" Kind="Numeric4CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="批量操作" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator5" Kind="Numeric5CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="代理配置" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator6" Kind="Numeric6CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="备份恢复" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator7" Kind="Numeric7CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="系统检测" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon x:Name="StepIndicator8" Kind="Numeric8CircleOutline" Width="28" Height="28"
                                         Foreground="#FF9E9E9E" HorizontalAlignment="Center"/>
                <TextBlock Text="完成" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#FF9E9E9E"/>
            </StackPanel>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="24,10,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBorder" Grid.Column="0" Width="120" Height="120"
                    Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,24,0">
                <materialDesign:PackIcon x:Name="StepIcon" Kind="HandWave" Width="64" Height="64"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="StepTitle" Text="欢迎使用Host管理器" FontWeight="Bold" FontSize="22" Margin="0,0,0,12"/>
                <TextBlock x:Name="StepDescription" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="#FF424242">
                    欢迎使用Host管理器！这是一款专业的Host文件管理工具，帮助您轻松管理本地域名解析配置。
                    支持多环境切换、批量操作、自动备份等高级功能，让您的开发测试工作更加高效便捷。
                    接下来的几步将带您了解本软件的主要功能。
                </TextBlock>
                <Border Background="#FFF3E5F5" CornerRadius="8" Margin="0,16,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="22" Height="22"
                                                 Foreground="#FF8E24AA" VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" x:Name="StepTip" TextWrapping="Wrap" FontSize="12" Foreground="#FF6A1B9A">
                            小提示：您可以随时通过菜单栏中的「帮助 → 使用教程」重新打开本教程。
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="DontShowAgainCheckBox"
                      Content="启动时不再显示此教程"
                      FontSize="13" VerticalAlignment="Center"
                      IsChecked="False"/>

            <Button Grid.Column="1" x:Name="PrevButton" Content="上一步" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    IsEnabled="False"
                    Click="PrevButton_Click"/>
            <Button Grid.Column="2" x:Name="NextButton" Content="下一步" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Click="NextButton_Click"/>
            <Button Grid.Column="3" x:Name="SkipButton" Content="跳过教程" Width="100"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="SkipButton_Click"/>
        </Grid>
    </Grid>
</Window>
