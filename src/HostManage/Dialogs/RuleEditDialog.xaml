<Window x:Class="HostManage.Dialogs.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="500"
        Title="规则编辑"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="500" Height="420">
    <Window.Resources>
        <Style x:Key="ValidationErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF44336"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="PencilBox" Width="28" Height="28"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding DialogTitle}" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IP地址:" VerticalAlignment="Center" FontSize="14"/>
                <StackPanel Grid.Column="1">
                    <TextBox materialDesign:HintAssist.Hint="例如: 127.0.0.1 或 ::1"
                             Text="{Binding IP, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:ValidationAssist.UsePopup="True"/>
                    <TextBlock Text="{Binding IPValidationMessage}" Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding IPHasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="域名:" VerticalAlignment="Top" FontSize="14"/>
                <StackPanel Grid.Column="1">
                    <TextBox materialDesign:HintAssist.Hint="例如: example.com 或 *.example.com"
                             Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:ValidationAssist.UsePopup="True"/>
                    <TextBlock Text="{Binding DomainValidationMessage}" Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding DomainHasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="备注:" VerticalAlignment="Top" FontSize="14"/>
                <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="可选，用于备注说明"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="启用规则:" VerticalAlignment="Center" FontSize="14"/>
                <ToggleButton Grid.Column="1" IsChecked="{Binding RuleIsEnabled}" HorizontalAlignment="Left"/>
            </Grid>

            <materialDesign:Card Padding="10" Background="#FFE3F2FD" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="24" Height="24" Foreground="#FF2196F3"
                                             VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="实时语法校验" FontWeight="SemiBold" FontSize="13" Foreground="#FF1976D2" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SyntaxMessage}" FontSize="12" Foreground="#FF1976D2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="取消" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="确定" Width="100"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    IsEnabled="{Binding IsValid}"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
