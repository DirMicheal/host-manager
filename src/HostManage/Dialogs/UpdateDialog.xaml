<Window x:Class="HostManage.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="520" d:DesignWidth="600"
        Title="版本更新"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="600" Height="520">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="Update" Width="32" Height="32"
                                     Foreground="White" Margin="24,16,16,16" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="0,16,24,16" VerticalAlignment="Center">
                <TextBlock Text="发现新版本" FontWeight="Bold" FontSize="22" Foreground="White"/>
                <TextBlock Text="推荐更新以获得更好的体验和功能" FontSize="13" Foreground="#FFE0E0E0" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,20,24,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0" Padding="16" Background="#FFF5F5F5">
                        <StackPanel>
                            <TextBlock Text="当前版本" FontSize="12" Foreground="#FF757575" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVersionText" Text="v1.0.0" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:PackIcon Grid.Column="1" Kind="ArrowRightBold" Width="28" Height="28"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="8,0,8,0"/>
                    <materialDesign:Card Grid.Column="2" Padding="16" Background="#FFE8F5E9">
                        <StackPanel>
                            <TextBlock Text="最新版本" FontSize="12" Foreground="#FF2E7D32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LatestVersionText" Text="v1.1.0" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#FF2E7D32"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="NoteTextOutline" Width="22" Height="22"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="更新内容" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <materialDesign:Card Padding="16" Background="#FFFAFAFA">
                    <StackPanel x:Name="ChangelogPanel">
                        <BulletDecorator Margin="0,0,0,10">
                            <BulletDecorator.Bullet>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                         Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="新增多环境对比功能，支持查看两个环境之间的规则差异" TextWrapping="Wrap" FontSize="13" Foreground="#FF424242" Margin="8,0,0,0"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,0,0,10">
                            <BulletDecorator.Bullet>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                         Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="新增批量导入导出功能，支持标准hosts文件和JSON格式" TextWrapping="Wrap" FontSize="13" Foreground="#FF424242" Margin="8,0,0,0"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,0,0,10">
                            <BulletDecorator.Bullet>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                         Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="优化代理配置模块，新增SOCKS5代理支持和连通性检测" TextWrapping="Wrap" FontSize="13" Foreground="#FF424242" Margin="8,0,0,0"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,0,0,10">
                            <BulletDecorator.Bullet>
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                         Foreground="#FFFF9800" VerticalAlignment="Center"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="修复部分情况下环境切换后Host文件未立即生效的问题" TextWrapping="Wrap" FontSize="13" Foreground="#FF424242" Margin="8,0,0,0"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,0,0,0">
                            <BulletDecorator.Bullet>
                                <materialDesign:PackIcon Kind="ArrowUpCircleOutline" Width="16" Height="16"
                                                         Foreground="#FF2196F3" VerticalAlignment="Center"/>
                            </BulletDecorator.Bullet>
                            <TextBlock Text="更新MaterialDesign和Newtonsoft.Json等第三方组件至最新版本" TextWrapping="Wrap" FontSize="13" Foreground="#FF424242" Margin="8,0,0,0"/>
                        </BulletDecorator>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,10,24,0" x:Name="DownloadProgressGrid" Visibility="Collapsed">
            <materialDesign:Card Padding="16" Background="#FFF0F7FF">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="DownloadStatusText" Text="正在下载更新..." FontSize="13" Foreground="#FF1565C0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="DownloadPercentText" Text="0%" FontSize="13" FontWeight="SemiBold" Foreground="#FF1565C0" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" BorderThickness="0"/>
                    <TextBlock x:Name="DownloadSizeText" Text="0 KB / 0 KB" FontSize="11" Foreground="#FF616161" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="3" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="AutoUpdateCheckBox"
                      Content="自动检测更新"
                      FontSize="13" VerticalAlignment="Center"
                      IsChecked="True"/>

            <Button Grid.Column="1" x:Name="LaterButton" Content="稍后更新" Width="110" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="LaterButton_Click"/>
            <Button Grid.Column="2" x:Name="UpdateButton" Content="立即更新" Width="110"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Click="UpdateButton_Click"/>
        </Grid>
    </Grid>
</Window>
