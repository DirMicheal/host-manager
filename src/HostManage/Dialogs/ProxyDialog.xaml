<Window x:Class="HostManage.Dialogs.ProxyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:HostManage.Models"
        mc:Ignorable="d"
        d:DesignHeight="500" d:DesignWidth="500"
        Title="代理配置"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="500" Height="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Server" Width="28" Height="28"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding DialogTitle}" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="代理名称:" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1" x:Name="NameTextBox"
                             materialDesign:HintAssist.Hint="例如: 公司代理"
                             Text="{Binding ProxyName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="代理类型:" VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ProxyTypes}"
                              SelectedItem="{Binding SelectedType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding Converter={StaticResource ProxyTypeToIconConverter}}"
                                                             Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="主机地址:" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             materialDesign:HintAssist.Hint="例如: proxy.example.com 或 192.168.1.1"
                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="端口:" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             materialDesign:HintAssist.Hint="例如: 8080"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <materialDesign:ColorZone Mode="Inners" Padding="8,4" Margin="0,4,0,8">
                    <TextBlock Text="身份验证（可选）" FontWeight="SemiBold" FontSize="12"/>
                </materialDesign:ColorZone>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="用户名:" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             materialDesign:HintAssist.Hint="留空则不使用认证"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="密码:" VerticalAlignment="Center" FontSize="14"/>
                    <PasswordBox Grid.Column="1" x:Name="PasswordBox"
                                 materialDesign:HintAssist.Hint="留空则不使用认证"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="测试连接" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="TestConnection_Click"/>
            <Button Grid.Column="2" Content="取消" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="3" Content="确定" Width="100"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
