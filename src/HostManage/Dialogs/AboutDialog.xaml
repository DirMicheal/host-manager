<Window x:Class="HostManage.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="580" d:DesignWidth="520"
        Title="关于"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="520" Height="580">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="72" Height="72"
                    Background="White" CornerRadius="16"
                    Margin="0,24,0,16" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Domain" Width="44" Height="44"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="24,0,24,20" HorizontalAlignment="Center">
                <TextBlock Text="Host 管理器" FontWeight="Bold" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Text="版本 v1.0.0" FontSize="13" Foreground="#FFE0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,20,24,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <materialDesign:Card Padding="16" Background="#FFFAFAFA" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Copyright" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="版权信息" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CopyrightText" Text="Copyright © 2026 HostManage. All rights reserved."
                                   FontSize="12" Foreground="#FF616161" TextWrapping="Wrap" Margin="26,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Web" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="官方网站" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="WebsiteLink" Text="https://www.hostmanage.app"
                                   FontSize="12" Foreground="#FF1976D2" TextWrapping="Wrap" Margin="26,0,0,0"
                                   Cursor="Hand" MouseLeftButtonUp="WebsiteLink_MouseLeftButtonUp"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Background="#FFFAFAFA" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="SourceRepository" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="开源组件声明" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="#FFF5F5F5" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Newtonsoft.Json" FontWeight="SemiBold" FontSize="13" Foreground="#FF212121"/>
                                    <TextBlock Text="高性能JSON序列化框架" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="v13.0.3" FontSize="11" Foreground="#FF1976D2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="MIT License" FontSize="10" Foreground="#FF4CAF50" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#FFF5F5F5" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MaterialDesignInXamlToolkit" FontWeight="SemiBold" FontSize="13" Foreground="#FF212121"/>
                                    <TextBlock Text="Material Design UI组件库" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="v5.1.0" FontSize="11" Foreground="#FF1976D2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="MIT License" FontSize="10" Foreground="#FF4CAF50" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#FFF5F5F5" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MaterialDesignColors" FontWeight="SemiBold" FontSize="13" Foreground="#FF212121"/>
                                    <TextBlock Text="Material Design配色方案" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="v3.1.0" FontSize="11" Foreground="#FF1976D2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="MIT License" FontSize="10" Foreground="#FF4CAF50" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#FFF5F5F5" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LiveChartsCore.SkiaSharpView.WPF" FontWeight="SemiBold" FontSize="13" Foreground="#FF212121"/>
                                    <TextBlock Text="跨平台图表绘制库" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="v2.0.0-rc2" FontSize="11" Foreground="#FF1976D2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="MIT License" FontSize="10" Foreground="#FF4CAF50" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#FFF5F5F5" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Microsoft.Extensions.DependencyInjection" FontWeight="SemiBold" FontSize="13" Foreground="#FF212121"/>
                                    <TextBlock Text="微软官方依赖注入容器" FontSize="11" Foreground="#FF757575" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="v8.0.0" FontSize="11" Foreground="#FF1976D2" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="MIT License" FontSize="10" Foreground="#FF4CAF50" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Background="#FFF8E1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Heart" Width="18" Height="18"
                                                     Foreground="#FFE65100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="致谢" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="#FFE65100"/>
                        </StackPanel>
                        <TextBlock Text="感谢所有开源社区贡献者为 .NET 生态系统做出的卓越贡献。"
                                   FontSize="12" Foreground="#FF6D4C00" TextWrapping="Wrap" Margin="26,0,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,10,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="检查更新" Width="110" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CheckUpdateButton_Click"/>
            <Button Grid.Column="2" Content="确定" Width="100"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
